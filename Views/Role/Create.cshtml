@model string
@{
	Layout = "_AdminLayout";
	ViewData["Title"] = "Create Role";
}
<div class="card shadow mb-4">
	<div class="card-header py-3">
		@* <h4 class="m-0 font-weight-bold text-primary">Buat Role Baru</h4> *@
		<h4>
			<b>
				Create New Role
			</b>
		</h4>
	</div>
	<div class="card-body">
		<form asp-action="Create" method="post">
			@Html.AntiForgeryToken()
			<div asp-validation-summary="All" class="text-danger"></div>
			<div class="form-group">
				<label for="name" class="control-label">Nama Role</label>
				@* Nama input harus sesuai dengan parameter di controller (string name) *@
				<input name="name" id="name" value="@Model" class="form-control" required />
			</div>
			<div class="form-group mt-3" align="center">
				<button type="submit" class="btn btn-primary btn-sm">
					<i class="fa fa-solid fa-save"></i> Create
				</button>
				<a asp-action="Index" class="btn btn-sm btn-warning">
					<i class="fa-sharp fa-solid fa-arrow-left"></i> Back to List
				</a>
			</div>
		</form>
	</div>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}