<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]</title>	
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />		
	<link href="~/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
	<link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
	<link href="~/css/site.css" rel="stylesheet" />
	<link href="~/css/kasir.css" rel="stylesheet" />	
</head>
<body>
	<header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <div class="row w-100 align-items-center" style="margin: 0;">
                    <div class="col-4 text-start">
                        <a class="navbar-brand app-title m-0" asp-controller="Kasir" asp-action="Index">
                            BelanjaCeriaApps 🛒
                        </a>
                    </div>
                    <div class="col-4 text-center">
                        <a class="btn btn-sm btn-primary text-white px-3" asp-action="Index" asp-controller="Shifts">
                            <i class="bi bi-cash-stack"></i> Shift Kasir
                        </a>
                    </div>
                    <div class="col-4 text-end">
                        <div class="d-flex justify-content-end align-items-center">
                            <partial name="_LoginPartial" />
                            <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                                <span class="navbar-toggler-icon"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
	</header>
	<div class="container-fluid">
		@RenderBody()
	</div>
	<footer id="kasir-footer" class="mt-2">
		<div>
			&copy; 2025 - POS System Apps
		</div>
	</footer>
	<script>
    document.addEventListener("DOMContentLoaded", function() {
        var shiftButton = document.querySelector('.navbar-nav .nav-link.btn');
        if (shiftButton) {
            shiftButton.style.setProperty('display', 'block', 'important');
            shiftButton.style.setProperty('opacity', '1', 'important');
            shiftButton.style.setProperty('visibility', 'visible', 'important');
        }
    });
</script>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>	
	<script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
