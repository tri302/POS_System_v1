@model InventoriEditVm

@{
    ViewData["Title"] = "Detail Inventori";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0 text-gray-800">Detail Transaksi Inventori</h2>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Back to list
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h6 class="m-0 font-weight-bold text-primary">Informasi Utama</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <label class="text-muted small d-block">No. Invoice / No. Faktur</label>
                    <span class="font-weight-bold text-dark">@Model.NoReferensi</span>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="text-muted small d-block">Tipe Stok</label>
                    <span>
                        @if (Model.TipeStok == "1")
                        {
                            <span class="badge bg-success">Masuk</span>
                        }
                        else if (Model.TipeStok == "2")
                        {
                            <span class="badge bg-danger">Keluar</span>
                        }
                        else if (Model.TipeStok == "3")
                        {
                            <span class="badge bg-info text-dark">Penyesuaian</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.TipeStok</span>
                        }
                    </span>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="text-muted small d-block">Jenis</label>
                    <span class="text-dark">
                        @if (Model.Sumber == "1")
                        {
                            <text>Penambahan Stock</text>
                        }
                        else if (Model.Sumber == "2")
                        {
                            <text>Barang Rusak</text>
                        }
                        else if (Model.Sumber == "3")
                        {
                            <text>Barang Kadaluarsa</text>
                        }
                        else if (Model.Sumber == "4")
                        {
                            <text>Stock Opname</text>
                        }
                        else
                        {
                            <text>@Model.Sumber</text>
                        }
                    </span>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="text-muted small d-block">Total Modal</label>
                    <span class="font-weight-bold text-primary">
                        @Model.TotalModal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))
                    </span>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="row border-top pt-3">
                    <div class="col-12">
                        <label class="text-muted small d-block">Catatan (Notes)</label>
                        <p class="mb-0 text-secondary">@Model.Notes</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h6 class="m-0 font-weight-bold text-primary">Daftar Produk / Item</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 5%">No</th>
                        <th>Nama Produk</th>
                        <th style="width: 15%">Satuan</th>
                        <th class="text-end" style="width: 15%">Harga Modal</th>
                        <th class="text-center" style="width: 12%">Jumlah</th>
                        <th class="text-end" style="width: 20%">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        int no=1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center">@(no++)</td>
                                <td>
                                    <span class="font-weight-bold text-dark">@item.NamaProduk</span>
                                </td>
                                <td>@(item.UnitName ?? "-")</td>
                                <td class="text-end">@item.HargaModal.ToString("C0", new System.Globalization.CultureInfo("id-ID"))</td>
                                <td class="text-center">@item.Jumlah</td>
                                <td class="text-end font-weight-bold">
                                    @((item.HargaModal * item.Jumlah).ToString("C0", new System.Globalization.CultureInfo("id-ID")))
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Tidak ada item dalam transaksi ini.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>