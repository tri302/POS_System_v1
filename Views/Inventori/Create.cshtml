@model POS_System.ViewModels.InventoriVm
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Inventori";
}
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-header">
            <h4>
                <b>
                    Details
                </b>
            </h4>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <!-- Kolom 1 -->
                <div class="col-md-3">
                    <label asp-for="NoReferensi" class="control-label"></label>
                    <div class="form-group mb-3">
                        <input asp-for="NoReferensi" class="form-control" id="NoReferensi" />
                        <span asp-validation-for="NoReferensi" class="text-danger"></span>
                    </div>
                </div>
                <!-- Kolom 2 -->
                <div class="col-md-3">
                    <label asp-for="TipeStok" class="control-label"></label>
                    <div class="form-group mb-3">
                        <div class="btn-group" role="group">
                            <input type="radio" class="btn-check tipe-stok" asp-for="TipeStok" value="1" id="stokMasuk" checked>
                            <label class="btn btn-outline-success" for="stokMasuk">Masuk</label>
                            <input type="radio" class="btn-check tipe-stok" asp-for="TipeStok" value="2" id="stokKeluar">
                            <label class="btn btn-outline-danger" for="stokKeluar">Keluar</label>
                            <input type="radio" class="btn-check tipe-stok" asp-for="TipeStok" value="3" id="stokPenyesuaian">
                            <label class="btn btn-outline-primary" for="stokPenyesuaian">Penyesuaian</label>
                        </div>
                    </div>
                </div>
                <!-- Kolom 3 -->
                <div class="col-md-3">
                    <div class="form-group mb-3">
                        <label asp-for="Sumber" class="control-label"></label>
                        <select asp-for="Sumber" id="sumberDropdown" class="form-control">
                        </select>
                        <span asp-validation-for="Sumber" class="text-danger"></span>
                    </div>
                </div>
                <!-- Kolom 4 -->
                <div class="col-md-3">
                    <div class="form-group mb-3">
                        <label asp-for="TotalModal" class="control-label"></label>
                        <div class="input-group">
                            <div class="input-group-text">Rp</div>
                            <input type="text" class="form-control" id="TotalModal" readonly="readonly" />
                            <!-- Input yang dikirim ke Server (Hidden) -->
                            <input asp-for="TotalModal" type="hidden" id="TotalModalHidden" />
                            <span asp-validation-for="TotalModal" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <span class="alert alert-info">
                    Field No Invoice/No Faktur wajib di isi jika tipe stok masuk.
                    Kosongkan jika tipe stok keluar dan penyesuaian.
                </span>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header">
            <h4>
                <b>
                    Pemilihan Produk
                </b>
            </h4>
        </div>
        <div id="InventoryItemsContainer" class="card-body">
            @* Menampung Item Inventori sebanyak n data *@
            <div class="card mb-3 inventory-item">
                <div class="card-header bg-light">
                    <div class="row align-items-center">
                        <div class="col text-start">
                            <strong><i class="bi bi-box-seam me-2"></i>Inventory Item</strong>
                        </div>
                        <div class="col text-end">
                            <i class="fa fa-trash text-danger BtnTrash" style="cursor:pointer;" title="Hapus Item"></i>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Barcode/Scan Produk</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                                <input type="text" autocomplete="off" name="ScanBarcode" class="form-control" placeholder="Scan barcode..." />
                                <button type="button" class="btn btn-success btn-scan-barcode" title="Scan">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                            <small class="text-muted d-block mt-1">
                                Untuk pencarian Produk gunakan <b>barcode</b> untuk produk pabrikan atau <b>nama produk</b> untuk produk non-pabrik.
                            </small>
                        </div>
                    </div>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Nama Produk</label>
                            <div class="input-group">
                                <select class="form-select form-control produk-dropdown" style="width: 100%;">
                                    <option value="">Pilih Produk</option>
                                </select>
                            </div>
                            <input type="hidden" name="IdProduk" class="produk-id-hidden" />
                            <input type="hidden" name="ProductUnitId" class="product-unit-id-hidden" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">Satuan Produk</label>
                            <input name="UnitName" class="form-control unitName" readonly />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Harga Modal</label>
                            <div class="input-group">
                                <span class="input-group-text">Rp</span>
                                <input name="HargaModal" class="form-control harga" readonly />
                            </div>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label fw-bold">Stok</label>
                            <input name="Stok" class="form-control text-center stok" readonly />
                        </div>
                        <div class="col">
                            <div class="qty-wrapper qty-normal-wrapper">
                                <label class="form-label fw-bold">Qty</label>
                                <div class="input-group">
                                    <button class="btn btn-outline-danger btn-minus" type="button">-</button>
                                    <input type="number" name="Jumlah" class="form-control text-center jumlah-normal" min="1" />
                                    <button class="btn btn-outline-success btn-plus" type="button">+</button>
                                </div>
                            </div>
                            <div class="qty-wrapper qty-opname-wrapper d-none">
                                <label class="form-label fw-bold">Penyesuaian Qty Selisih</label>
                                <div class="input-group">
                                    <select class="form-select adjustment-type" style="max-width: 65px; background-color: #f8f9fa;">
                                        <option value="plus" selected>+</option>
                                        <option value="minus">-</option>
                                    </select>
                                    <input type="number" class="form-control text-center jumlah-opname" name="Jumlah" min="0" placeholder="0" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div align="center">
        <button type="button" class="btn btn-info btn-sm mt-2 mb-2" id="BtnAddInventoriItems">
            <i class="fa fa-plus-square"></i>
            Tambahkan Inventori Items
        </button>
    </div>
    <div class="card">
        <div class="card-header">
            <h4>
                <b>
                    Catatan
                </b>
            </h4>
        </div>
        <div class="card-body">
            <div class="form-group">
                <label asp-for="Notes" class="control-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
        <div class="form-group mt-2 mb-2" align="center">
            <button asp-controller="Inventori" type="submit" class="btn btn-primary btn-sm">
                <i class="fa fa-solid fa-save"></i> Create
            </button>
            <a asp-action="Index" class="btn btn-sm btn-warning">Back to List</a>
        </div>
    </div>
</form>
@section Scripts {
    @{
        <script src="~/js/inventoricreate.js"></script>
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
