@model List<POS_System.ViewModels.InventoriVm>
@if (Model != null && Model.Any())
{
    @foreach (var item in Model)
    {
        string isPlusSelected = item.Jumlah >= 0 ? "selected" : null;
        string isMinusSelected = item.Jumlah < 0 ? "selected" : null;
        <div class="card mb-3 inventory-item">
            <div class="card-header">
                <div class="row w-100">
                    <div class="col text-start">
                        <strong>Inventory Item</strong>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Barcode/Scan Produk</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                            <input type="text" value="@item.KodeBarcode" autocomplete="off" name="ScanBarcode" class="form-control" placeholder="Scan barcode..." />
                            <button type="button" class="btn btn-success btn-scan-barcode" title="Scan">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                        <small class="text-muted d-block mt-1">
                            Untuk pencarian Produk gunakan <b>barcode</b> untuk produk pabrikan atau <b>nama produk</b> untuk produk non-pabrik.
                        </small>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">                        
                        <input type="hidden" class="inventori-id-hidden" value="@item.IdInventori" />
                        <label class="form-label fw-bold">Nama Produk</label>
                        <div class="input-group">
                            <select name="@item.IdProduk" class="form-control produk-dropdown" style="width: 100%;">
                                @if (item.IdProduk > 0)
                                {
                                    <option value="@item.IdProduk" selected>@item.NamaProduk</option>
                                }
                            </select>
                        </div>
                        <input type="hidden" class="produk-id-hidden" value="@item.IdProduk" />
                        <input type="hidden" class="product-unit-id-hidden" value="@item.ProductUnitId" />
                    </div>
                    <div class="col-md-2">
                        <input type="hidden" name="ProductUnitId" value="@item.ProductUnitId" />
                        <label class="form-label">Satuan Produk</label>
                        <select name="ProductUnitId" class="form-control ProductUnitId-dropdown">
                            @if (item.ProductUnitId > 0)
                            {
                                <option value="@item.ProductUnitId" selected>@item.UnitName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label>Harga Modal</label>
                        <div class="input-group">
                            <span class="input-group-text">Rp</span>
                            <input type="text" class="form-control hargaModal"
                                   value="@item.HargaModal" readonly="readonly" />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label>Stok</label>
                        <input type="number" name="Stok" class="form-control stok" value="@item.Stok" readonly="readonly" />
                    </div>
                    <div class="col">
                        <div class="qty-wrapper qty-normal-wrapper">
                            <label class="form-label fw-bold">Qty</label>
                            <div class="input-group">
                                <button class="btn btn-outline-danger btn-minus" type="button">-</button>
                                <!-- PERBAIKAN: Tambahkan data-jumlah-awal & kelas hitung-delta -->
                                <input type="number" name="Jumlah" value="@Math.Abs(item.Jumlah)"
                                       data-jumlah-awal="@item.Jumlah"
                                       class="form-control text-center jumlah-normal hitung-delta" min="1" />
                                <button class="btn btn-outline-success btn-plus" type="button">+</button>
                            </div>
                        </div>
                        <div class="qty-wrapper qty-opname-wrapper d-none">
                            <label class="form-label fw-bold">Penyesuaian Qty Selisih</label>
                            <div class="input-group">
                                <select class="form-select adjustment-type" style="max-width: 65px; background-color: #f8f9fa;">
                                    <option value="plus" selected="@(item.Jumlah >= 0 ? "selected" : null)">+</option>
                                    <option value="minus" selected="@(item.Jumlah < 0 ? "selected" : null)">-</option>
                                </select>
                                <!-- PERBAIKAN: Tambahkan data-jumlah-awal & kelas hitung-delta -->
                                <input type="number" class="form-control text-center jumlah-opname hitung-delta"
                                       data-jumlah-awal="@item.Jumlah"
                                       value="@Math.Abs(item.Jumlah)" min="0" placeholder="0" />
                            </div>
                        </div>
                        <!-- TEMPAT BADGE DELTA REAL-TIME -->
                        <div class="mt-1 info-delta-container" style="font-size: 0.85rem;"></div>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-warning text-center">No records found.</div>
}