@model POS_System.ViewModels.TransaksiVm
@{
    Layout = "_AdminLayout";
}
<div class="p-4">
    <nav class="text-muted mb-2">
        <small>Transaksi > Lihat</small>
    </nav>
    <h4 class="fw-bold mb-4">Detail Pesanan</h4>
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="border rounded p-2 bg-light">
                <small class="text-muted d-block">No. Transaksi :</small>
                <span class="badge bg-light text-dark border">@Model.NoTransaksi</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-2 bg-light">
                <small class="text-muted d-block">Nama Customer :</small>
                <span class="badge bg-success-subtle text-dark border">@Model.NamaPemesan</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-2 bg-light">
                <small class="text-muted d-block">Metode Pembayaran :</small>
                <span class="badge bg-info-subtle text-dark border">@Model.NamaMetodeBayar</span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="border rounded p-2 bg-light">
                <small class="text-muted d-block">Tanggal Transaksi :</small>
                <span class="badge bg-info-subtle text-dark border">
                    @Model.TanggalTransaksi.ToString("yyyy-MM-dd HH:mm:ss")
                </span>
            </div>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Transaction Items</strong>
        </div>
        <div class="card-body p-0">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Gambar</th>
                        <th>Nama Produk</th>
                        <th>Satuan Produk</th>
                        <th class="text-center">Jumlah</th>
                        <th class="text-end">Harga Modal</th>
                        <th class="text-end">Harga Jual</th>
                        <th class="text-end">Profit</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TransaksiDetails != null && Model.TransaksiDetails.Any())
                    {
                        foreach (var item in Model.TransaksiDetails)
                        {
                            <tr>
                                <td style="width:200px">
                                    <img src="@item.Gambar" class="img-thumbnail" style="width:100px; height:100px; object-fit:cover" />
                                </td>
                                <td>@item.NamaProduk</td>
                                <td>@item.UnitName</td>
                                <td class="text-center">@item.Qty</td>
                                <td class="text-end">@string.Format(new System.Globalization.CultureInfo("id-ID"), "{0:C0}", item.HargaModal)</td>
                                <td class="text-end">@string.Format(new System.Globalization.CultureInfo("id-ID"), "{0:C0}", item.HargaJual)</td>
                                <td class="text-end text-success fw-bold">@string.Format(new System.Globalization.CultureInfo("id-ID"), "{0:C0}", item.Profit)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Tidak ada item transaksi.</td>
                        </tr>
                    }
                </tbody>  
                <tfoot class="table-light">
                    <tr>
                        <td colspan="6" class="text-end fw-bold">Total Profit</td>
                        <td class="text-end fw-bold text-success">
                            @string.Format(new System.Globalization.CultureInfo("id-ID"), "{0:C0}", Model.TransaksiDetails.Sum(x => x.Profit))
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="card-footer text-muted small">
            Menampilkan @Model.TransaksiDetails.Count() hasil
        </div>
    </div>
</div>
@section Styles {
    <style>
        .badge.bg-success-subtle {
            background-color: #eaf7ea;
        }
        .badge.bg-info-subtle {
            background-color: #e6f4ff;
        }
        .table th {
            font-weight: 600;
        }
    </style>
}