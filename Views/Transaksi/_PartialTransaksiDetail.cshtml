@model IEnumerable<POS_System.ViewModels.TransaksiItemVm>
@foreach (var item in Model)
{
    <div class="card mb-3 transaksi-item">
        <div class="card-header">
            <div class="row w-100">
                <div class="col text-start">
                    <strong>Item Produk</strong>
                </div>
                <div class="col text-end">
                    <i class="fa fa-trash text-danger BtnTrash" style="cursor:pointer;"></i>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Barcode/Scan Produk</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                        <input type="text" autocomplete="off" value="@item.KodeBarcode" name="ScanBarcode" class="form-control" placeholder="Scan barcode..." />
                        <button type="button" class="btn btn-success btn-scan-barcode" title="Scan">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                    <small class="text-muted d-block mt-1">
                        Untuk pencarian Produk gunakan <b>barcode</b> untuk produk pabrikan atau <b>nama produk</b> untuk produk non-pabrik.
                    </small>
                </div>
            </div>
            <div class="row d-flex align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Nama Produk</label>
                    <div class="form-group">
                        <select class="form-control NamaProdukSelect" name="IdProduk">
                            <option value="@item.IdProduk">@item?.NamaProduk</option>
                        </select>
                        <input type="hidden" name="IdProduk" class="produk-id-hidden" value="@item.IdProduk" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Satuan Produk</label>
                    <div class="form-group">
                        <select class="form-control SatuanProduk-dropdown" name="ProductUnitId" data-konversi="@item.Conversion">
                            @if (item.AvailableUnitsOption != null && item.AvailableUnitsOption.Any())
                            {
                                foreach (var unit in item.AvailableUnitsOption)
                                {
                                    <option value="@unit.ProductUnitId"
                                            data-konversi="@unit.Conversion"
                                            selected="@(unit.ProductUnitId == item.ProductUnitId)">
                                        @unit.UnitName
                                    </option>
                                }
                            }
                            else
                            {
                                <option value="@item.ProductUnitId" data-konversi="@item.Conversion" selected>@item.UnitName</option>
                            }
                        </select>
                        <input type="hidden" name="ProductUnitId" class="SatuanProduk-id-hidden" value="@item.ProductUnitId" />
                        <br />                        
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-group">
                        <label>Harga Modal</label>
                        <div class="input-group">
                            <div class="input-group-text">Rp</div>
                            <input name="HargaModal" class="form-control hargaModal" readonly
                                   value="@item.HargaModal.ToString("N0")" data-raw="@item.HargaModal" />
                        </div>
                        <span class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row d-flex align-items-end mt-3">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Harga Jual</label>
                        <div class="input-group">
                            <div class="input-group-text">Rp</div>
                            <input name="HargaJual" class="form-control hargaJual" readonly
                                   value="@item.HargaJual.ToString("N0")" data-raw="@item.HargaJual" />
                        </div>
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label>Stok</label>
                        <input name="Stok" class="form-control text-center" readonly value="@item.Stok" />
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Profit</label>
                        <div class="input-group">
                            <div class="input-group-text">Rp</div>
                            <input name="Profit" class="form-control profit" readonly value="@item.Profit.ToString("N0")" data-raw="@item.Profit" />
                        </div>
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Qty</label>
                        <div class="input-group">
                            <button class="btn btn-outline-danger btn-minus" type="button">-</button>
                            <input type="number" name="Jumlah" class="form-control text-center jumlah" value="@item.Qty" min="1" id="inputJumlah" style="max-width: 80px;" />
                            <button class="btn btn-outline-success btn-plus" type="button">+</button>
                        </div>
                        <span class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}