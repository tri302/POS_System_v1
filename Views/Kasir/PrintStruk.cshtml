@model POS_System.Models.Transaksi
@using System.Globalization
@{
    // INI WAJIB agar gambar dashboard kasir tidak masuk ke struk
    Layout = null; 
    var total = Model.TransaksiDetails.Sum(i => i.HargaJual * i.Qty);
    var rupiahCulture = new CultureInfo("id-ID");
    var toko = ViewBag.TokoSettings as POS_System.Models.PengaturanToko;
    var logoPath = toko?.LogoToko;
    var namaToko = toko?.NamaToko ?? "TOKO MAJU MANDIRI";
    var alamatToko = toko?.AlamatToko ?? "Jl. Lintas Sumatera Palembang-Jambi KM 83.5";
    var telpToko = toko?.NomorTelepon ?? "085767643242";
}
<!DOCTYPE html>
<html>
<head>
    <title>Struk #@Model.NoTransaksi</title>
    <style>
        /* Ukuran Kertas Kasir Thermal 80mm */
        @@page {
            size: 80mm auto;
            margin: 0;
        }
        body {
            font-family: 'Courier New', Courier, monospace;
            font-size: 12px;
            color: #000;
            width: 74mm;
            margin: 0 auto;
            padding: 4mm 0;
        }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .line { border-top: 1px dashed #000; margin: 5px 0; }
        table { width: 100%; border-collapse: collapse; }
        td { vertical-align: top; padding: 2px 0; }
        .logo { max-width: 20mm; max-height: 20mm; display: block; margin: 0 auto 5px auto; }
    </style>
</head>
<body>
    <div class="text-center">
        @if (!string.IsNullOrEmpty(logoPath))
        {
            <img src="@logoPath" class="logo" alt="Logo" />
        }
        <strong>@namaToko</strong><br />
        @alamatToko<br />
        @telpToko
    </div>
    <div class="line"></div>
    <table>
        <tr><td>No : @Model.NoTransaksi</td></tr>
        <tr><td>Kasir : @(Model.Karyawans?.Name ?? "Owner")</td></tr>
        <tr><td>Tgl : @Model.TanggalTransaksi.ToString("dd/MM/yyyy HH:mm")</td></tr>
        <tr><td>Customer : @(Model.Pelanggan?.Nama ?? "UMUM")</td></tr>
        <tr><td>Metode Bayar : @(Model.MetodeBayar?.NamaMetodeBayar ?? "Cash")</td></tr>
    </table>
    <div class="line"></div>
    <table>
        @foreach (var item in Model.TransaksiDetails)
        {
            <tr>
                <td colspan="2">@item.Produk?.NamaProduk</td>
            </tr>
            <tr>
                <td>@item.Qty x @item.HargaJual.ToString("N0", rupiahCulture)</td>
                <td class="text-right">@((item.Qty * item.HargaJual).ToString("N0", rupiahCulture))</td>
            </tr>
        }
    </table>
    <div class="line"></div>
    <table>
        <tr>
            <td><strong>Total</strong></td>
            <td class="text-right"><strong>@total.ToString("N0", rupiahCulture)</strong></td>
        </tr>
        <tr>
            <td>Bayar</td>
            <td class="text-right">@Model.NominalBayar.ToString("N0", rupiahCulture)</td>
        </tr>
        <tr>
            <td>Kembalian</td>
            <td class="text-right">@Model.Kembalian.ToString("N0", rupiahCulture)</td>
        </tr>
    </table>
    <div class="line"></div>
    <div class="text-center">
        Terima kasih atas kunjungan Anda!<br />
        Barang yang sudah dibeli tidak dapat dikembalikan.
    </div>
</body>
</html>