@using POS_System
@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Login - POS System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            height: 100vh;
            overflow: hidden;
            font-family: 'Source Sans 3', sans-serif;
        }
        /* LAYOUT GRID */
        .login-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }
        /* LEFT SIDE (60%)*/
        .left-side {
            width: 60%;
            background: linear-gradient(135deg, #3b82f6, #9333ea, #10b981, #f472b6);
            background-size: 400% 400%;
            animation: gradientMove 15s ease infinite;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }
        /* ANIMATED GRADIENT */
        @@keyframes gradientMove {
            0%
        {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
        }
        /* KONTEN KIRI - KASIR DAN IKON TAMBAHAN */
        .pos-illustration-container {
            position: relative;
            z-index: 10;
            text-align: center;
            padding: 20px;
        }
        /* PENGATURAN GAMBAR UTAMA */
        .kasir-main-icon {
            max-width: 100%;
            height: auto;
            filter: none;
            opacity: 1;
            margin-bottom: 20px;
            animation: fadeIn 1s ease-out;
        }
        /* IKON-IKON TAMBAHAN BERTEMA POS */
        .pos-extra-icons {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            pointer-events: none;
        }
        .pos-icon {
            position: absolute;
            color: rgba(255, 255, 255, 0.7);
            font-size: 40px;
            text-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }
        /* Posisi Ikon */
        .icon-cart {
            top: 15%;
            left: 10%;
            animation: float 6s ease-in-out infinite;
        }
        .icon-tag {
            top: 30%;
            right: 5%;
            font-size: 30px;
            animation: float 7s ease-in-out infinite reverse;
        }
        .icon-dollar {
            bottom: 20%;
            left: 5%;
            font-size: 50px;
            animation: float 8s ease-in-out infinite;
        }
        .icon-receipt {
            bottom: 10%;
            right: 15%;
            font-size: 35px;
            animation: float 5s ease-in-out infinite reverse;
        }
        .icon-credit-card {
            top: 5%;
            right: 25%;
            font-size: 45px;
            animation: float 9s ease-in-out infinite;
        }
        /* ANIMASI FLOAT */
        @@keyframes float {
            0%
        {
            transform: translateY(0px) rotate(0deg);
        }
        50% {
            transform: translateY(-15px) rotate(2deg);
        }
        100% {
            transform: translateY(0px) rotate(0deg);
        }
        }
        /* BLUR GLASS EFFECT */
        .glass-bg {
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            filter: blur(120px);
            z-index: 5;
        }
        /* RIGHT SIDE (40%) */
        .right-side {
            width: 40%;
            background: #f7f9fc;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.08);
        }
        .login-card {
            width: 100%;
            max-width: 380px;
            background: white;
            border-radius: 20px;
            padding: 35px 30px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
            animation: slideUp 0.6s ease forwards;
            opacity: 0;
            transform: translateY(40px);
        }
        @@keyframes slideUp {
            to
        {
            opacity: 1;
            transform: translateY(0);
        }
        }
        @@keyframes fadeIn {
            from
        {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
        }
        .avatar {
            width: 85px;
            height: 85px;
            border-radius: 50%;
            border: 3px solid #3b82f6;
            margin-bottom: 15px;
            object-fit: cover;
        }
        .login-title {
            font-size: 1.9rem;
            font-weight: bold;
            color: #333;
        }
        button {
            border-radius: 10px;
            padding: 10px;
            font-size: 1rem;
        }
        /* Responsive untuk layar kecil */
        @@media (max-width: 768px) {
            .left-side
        {
            display: none;
        }
        .right-side {
            width: 100%;
        }
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="left-side">
            <div class="glass-bg"></div>
            <div class="pos-illustration-container">
                <img src="~/images/kasir-transaksi.png" alt="Kasir Transaksi" class="kasir-main-icon" />
                <div class="pos-extra-icons">
                    <i class="fas fa-shopping-cart pos-icon icon-cart"></i>
                    <i class="fas fa-tag pos-icon icon-tag"></i>
                    <i class="fas fa-dollar-sign pos-icon icon-dollar"></i>
                    <i class="fas fa-receipt pos-icon icon-receipt"></i>
                    <i class="far fa-credit-card pos-icon icon-credit-card"></i>
                </div>
                <h2 style="color: white; text-shadow: 0 2px 4px rgba(0,0,0,0.4); margin-top: -20px;">Point of Sale System</h2>
            </div>
        </div>
        <div class="right-side">
            <div class="login-card text-center">
                <img src="~/images/AvatarLoginPage.png" class="avatar" />
                <div class="login-title mb-2">Welcome Back</div>
                <p class="text-muted">Sign in to start your session</p>
                <form method="post" id="account">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3 text-start">
                        <label class="form-label">Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="Email" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3 text-start">
                        <label class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-lock"></i></span>
                            <input asp-for="Password" id="password" class="form-control" placeholder="Password" autocomplete="current-password" />
                            <!-- Tombol Mata -->
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                <i class="fa fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="RememberMe" />
                            <label class="form-check-label">Remember me</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Sign In</button>
                </form>
            </div>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <partial name="_ValidationScriptsPartial" />
    <script>
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password');
    const eyeIcon = document.querySelector('#eyeIcon');
    togglePassword.addEventListener('click', function (e) {
        // Toggle tipe input
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        // Toggle ikon mata
        eyeIcon.classList.toggle('fa-eye');
        eyeIcon.classList.toggle('fa-eye-slash');
    });
</script>
    <script>
        // Cek apakah ada pesan error dari controller
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Gagal Login',
                        text: '@TempData["ErrorMessage"]',
                        confirmButtonColor: '#2563eb', // Sesuai warna biru tailwind Anda
                        confirmButtonText: 'Coba Lagi',
                        position:'top'
                    });
            </text>
        }
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var errorMessage = '@TempData["LoginError"]';
            if (errorMessage) {
                Swal.fire({
                    icon: 'error',
                    title: 'Login Gagal',
                    text: errorMessage,
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'Coba Lagi'
                });
            }
        });
    </script>
</body>
</html>