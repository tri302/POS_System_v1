@model POS_System.ViewModels.MetodeBayarVmEdit
@{
    ViewData["Title"] = "Edit";
    //Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="modal" tabindex="-1" id="ModalEdit" data-bs-backdrop="static" data-bs-keyboard="false">
	<div class="modal-dialog">
		<form asp-action="_Edit" method="post" enctype="multipart/form-data">
			<input type="hidden" asp-for="IdMetodeBayar" />
			<div class="modal-content">
				<div class="modal-header">
					<h4 class="modal-title">
						<b>Edit Metode Bayar</b>
					</h4>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="card">
						<div class="card-body">
							<div class="row">
								<div class="col-md-12">									
									<div asp-validation-summary="ModelOnly" class="text-danger"></div>
									<div class="form-group">
										<label asp-for="NamaMetodeBayar" class="control-label"></label>
										<input asp-for="NamaMetodeBayar" class="form-control" placeholder="Cash, Transfer Bank, Qris" />
										<span asp-validation-for="NamaMetodeBayar" class="text-danger"></span>
									</div>
									<div class="form-group">
										<label asp-for="UploadGambarEdit"></label>
										<input asp-for="UploadGambarEdit" type="file" class="form-control" />
										<span asp-validation-for="UploadGambarEdit" class="text-danger"></span>
										<input type="hidden" asp-for="UrlGambar" />@* Untuk menyimpan URL gambar lama *@
									</div>
								</div>
							</div>
						</div>
					</div>
					<div class="modal-footer justify-content-center">									
					<button type="submit" class="btn btn-primary btn-sm">
							<i class="fa fa-plus-square"></i> Simpan Perubahan
						</button>
						<a asp-action="Index" class="btn btn-sm btn-warning">Back to List</a>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
