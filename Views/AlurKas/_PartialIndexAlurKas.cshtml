@model POS_System.ViewModels.AlurKasVm
<style>
	.icon-box {
		width: 55px;
		height: 55px;
		display: flex;
		justify-content: center;
		align-items: center;
		border-radius: 14px;
		color: white;
		font-size: 24px;
		opacity: .9;
	}
		.icon-box i {
			transform: translateY(1px);
		}
	.card:hover {
		transform: translateY(-3px);
		transition: .2s;
	}
</style>
<div class="row g-3">
	<!-- Total Modal -->
	<div class="col-md-3">
		<div class="card shadow-sm border-0 bg-white p-3 rounded-3">
			<div class="d-flex justify-content-between">
				<div>
					<span class="text-muted small">Total Modal</span>
					<h4 class="fw-bold mt-1" id="totalModalIndex">@Model.TotalModal</h4>
				</div>
				<div class="icon-box bg-primary">
					<i class="fa-solid fa-coins"></i>
				</div>
			</div>
		</div>
	</div>
	<!-- Total Uang Masuk -->
	<div class="col-md-3">
		<div class="card shadow-sm border-0 bg-white p-3 rounded-3">
			<div class="d-flex justify-content-between">
				<div>
					<span class="text-muted small">Total Uang Masuk</span>
					<h4 class="fw-bold mt-1 text-success" id="totalMasukIndex">@Model.TotalUangMasuk</h4>
				</div>
				<div class="icon-box bg-success">
					<i class="fa-solid fa-arrow-trend-up"></i>
				</div>
			</div>
		</div>
	</div>
	<!-- Total Uang Keluar -->
	<div class="col-md-3">
		<div class="card shadow-sm border-0 bg-white p-3 rounded-3">
			<div class="d-flex justify-content-between">
				<div>
					<span class="text-muted small">Total Uang Keluar</span>
					<h4 class="fw-bold mt-1 text-danger" id="totalKeluarIndex">@Model.TotalUangKeluar</h4>
				</div>
				<div class="icon-box bg-danger">
					<i class="fa-solid fa-arrow-trend-down"></i>
				</div>
			</div>
		</div>
	</div>
	<!-- Total Uang Toko -->
	<div class="col-md-3">
		<div class="card shadow-sm border-0 bg-white p-3 rounded-3">
			<div class="d-flex justify-content-between">
				<div>
					<span class="text-muted small">Total Uang Toko</span>
					<h4 class="fw-bold mt-1" id="totalTokoIndex">@Model.TotalUangToko</h4>
					<div class="small mt-1">
						<span class="text-success">Masuk: <span id="masukTokoIndex">@Model.TotalUangMasuk</span></span> <br />
						<span class="text-danger">Keluar: <span id="keluarTokoIndex">@Model.TotalUangKeluar</span></span>
					</div>
				</div>
				<div class="icon-box bg-dark">
					<i class="fa-solid fa-wallet"></i>
				</div>
			</div>
		</div>
	</div>
</div>
