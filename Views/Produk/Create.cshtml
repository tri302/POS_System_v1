@model POS_System.ViewModels.ProdukVm
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Produk";
}
<div class="card">
    <div class="card-header">
        <h4>
            <b>Create Produk</b>
        </h4>
    </div>
    <div class="card-body">
        <form asp-action="Create" enctype="multipart/form-data" method="post">
            @Html.AntiForgeryToken()
            <div class="row">
                <!-- Kolom Kiri -->
                <div class="col-md-6">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label>Barcode</label>
                        <input type="text" id="KodeBarcode" name="KodeBarcode" class="form-control" />
                        <span asp-validation-for="KodeBarcode" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="NamaProduk" class="control-label"></label>
                        <input asp-for="NamaProduk" class="form-control" />
                        <span asp-validation-for="NamaProduk" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label>Stok</label>
                        <input asp-for="Stok" class="form-control" />
                        <span asp-validation-for="Stok" class="text-danger"></span>
                        <small class="form-text text-muted d-block mt-1">
                            * Masukkan jumlah stok dalam <strong>satuan terkecil/dasar</strong> (misal: Pcs, Botol, Gram).
                        </small>
                        <small class="form-text text-muted d-block">
                            * <strong>Contoh:</strong> Jika Anda punya 2 Dus Mie (1 Dus = 40 Pcs), maka isi dengan angka <strong>80</strong>.
                        </small>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="NamaKategori" class="control-label"></label>
                        <select asp-for="IdKategori" class="form-control" asp-items="@Model.KategoriList">
                            <option value="">Pilih Kategori</option>
                        </select>
                        <span asp-validation-for="IdKategori" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="SKU" class="control-label"></label>
                        <input asp-for="SKU" class="form-control" placeholder="" />
                        <span asp-validation-for="SKU" class="text-danger"></span>
                    </div>
                    <label class="control-label"> Status Produk</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="StatusProduk" id="statusAktif" value="Aktif">
                        <label class="form-check-label" for="statusAktif">Aktif</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="StatusProduk" id="statusTidakAktif" value="Tidak Aktif">
                        <label class="form-check-label" for="statusTidakAktif">Tidak Aktif</label>
                        <br />
                        <span asp-validation-for="StatusProduk" class="text-danger"></span>
                    </div>
                </div>
                <!-- Kolom Kanan -->
                <div class="col-md-6">
                    <div class="form-group mb-3" align="center">
                        <label class="control-label">Preview Gambar </label>
                        <div id="PriviewGambar">
                            <img id="imgPreview"
                                 src="@Url.Content("~/images/no-image.png")"
                                 alt="Preview Gambar"
                                 class="img-thumbnail"
                                 height="200"
                                 width="200"
                                 onerror="this.src='/images/noimage.png'" />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="UploadGambar" class="control-label"></label>
                        <input asp-for="UploadGambar" id="UploadImg" class="form-control" type="file" onchange="previewImage(event)" />
                        <span asp-validation-for="UploadGambar" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Deskripsi" class="control-label"></label>
                        <textarea asp-for="Deskripsi" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Deskripsi" class="text-danger"></span>
                    </div>
                </div>
                <!-- Kolom product unit -->
                <div class="col-md-12 mt-2">
                    <div class="card">
                        <div class="card-body">
                            <div class="form-group">
                                <h4 class="me-1 px-1">
                                    <b>
                                        <label>Unit Produk</label>
                                        <hr />
                                    </b>
                                </h4>
                                <small class="text-muted">
                                    Satu Produk bisa memiliki satuan unit dan harga yang berbeda-beda.
                                </small>
                                <br />
                                <small class="text-muted">
                                    Tambahkan unit produk beserta stok, harga modal, conversion value dan harga jualnya.
                                </small>
                                <br />
                                <small class="text-muted">
                                    Is Default wajib di check untuk menentukan satuan dasar unit produk.
                                </small>
                                <div class="row">
                                    <div class="col-md-12">
                                        <table class="table table-bordered table-sm" id="tableUnits">
                                            <thead>
                                                <tr>
                                                    <th style="width:50px">
                                                        Is Default
                                                    </th>
                                                    <th style="width: 150px">Unit</th>
                                                    <th style="width: 20px">Conversion Value</th>
                                                    <th style="width: 100px">Harga Modal</th>
                                                    <th style="width: 100px">Harga Jual</th>
                                                    <th style="width: 50px">#</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            </tbody>
                                        </table>
                                        <div align="center" class="mt-2">
                                            <button type="button" id="addUnit" class="btn btn-primary btn-sm">
                                                <i class="fa fa-plus"></i>
                                                Add Unit Produk
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Tombol -->
            <div class="form-group mt-3" align="center">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa fa-solid fa-save"></i> Create
                </button>
                <a asp-action="Index" class="btn btn-sm btn-warning">
                    <i class="fa-sharp fa-solid fa-arrow-left"></i>
                    Back to List
                </a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    @* isi tabel body untuk produk unit *@
    <script>
        // Variabel untuk melacak jumlah unit yang sudah ditambahkan
        let unitIndex = 0;
        $("#addUnit").click(function(){
            // Gunakan `unitIndex` untuk membuat `name` dan `id` yang unik
            $("#tableUnits tbody").append(`
                <tr>
                    <td>
                        <div class="input-group mb-3 justify-content-center">
                            <input class="form-check-input" type="radio" name="DefaultUnitIndex" value="` + unitIndex + `">
                            <input type="hidden" name="ProductUnits[` + unitIndex + `].Is_Default" id="hiddenIsDefault_` + unitIndex + `" value="false">
                        </div>
                    </td>
                    <td>
                        <input type="text" name="ProductUnits[` + unitIndex + `].UnitName" class="form-control" placeholder="Unit Produk (Pcs,Dus)"/>
                    </td>
                    <td>
                        <input type="text" oninput="this.value = this.value.replace(/[^0-9]/g, '')" name="ProductUnits[` + unitIndex + `].ConversionValue" class="form-control" placeholder="harus di isi angka"/>
                    </td>
                    <td>
                        <input type="text" class="form-control currency-display-modal" id="HargaModalDisplay_` + unitIndex + `" placeholder="Harga Modal Produk"/>
                        <input type="hidden" name="ProductUnits[` + unitIndex + `].HargaModal" class="currency-hidden-modal" id="HargaModal_` + unitIndex + `" />
                    </td>
                    <td>
                        <input type="text" class="form-control currency-display-jual" id="HargaJualDisplay_` + unitIndex + `" placeholder="Harga Jual Produk"/>
                        <input type="hidden" name="ProductUnits[` + unitIndex + `].HargaJual" class="currency-hidden-jual" id="HargaJual_` + unitIndex + `" />
                    </td>
                    <td><button type="button" class="btn btn-danger btn-sm remove">X</button></td>
                </tr>
            `);
            // Panggil fungsi setupCurrencyFormat untuk input yang baru ditambahkan
            setupCurrencyFormat($('#HargaModalDisplay_' + unitIndex), $('#HargaModal_' + unitIndex));
            setupCurrencyFormat($('#HargaJualDisplay_' + unitIndex), $('#HargaJual_' + unitIndex));
            unitIndex++; // Naikkan index untuk baris berikutnya
        });
            $(document).on("click", ".remove", function(){
            $(this).closest("tr").remove();
            // Re-index ulang semua name input setelah ada yang dihapus
            $("#tableUnits tbody tr").each(function(index) {
                $(this).find("input").each(function() {
                    var name = $(this).attr("name");
                    if (name) {
                        // Ganti angka di dalam kurung siku dengan index baru
                        var newName = name.replace(/\[\d+\]/, "[" + index + "]");
                        $(this).attr("name", newName);
                    }
                });
            });
        });
        // Fungsi untuk format mata uang
        function setupCurrencyFormat(displayElement, hiddenElement) {
            displayElement.on("input", function (e) {
                // Hapus semua karakter non-digit kecuali tanda koma (jika ada, meskipun untuk IDR sebaiknya angka murni)
                let raw = e.target.value.replace(/\D/g, "");
                if (raw) {
                    // Format angka ke format mata uang Indonesia (tanpa simbol Rp)
                    let formatted = new Intl.NumberFormat("id-ID").format(raw);
                    displayElement.val(formatted);
                    // Simpan angka murni ke input hidden
                    hiddenElement.val(raw);
                } else {
                    displayElement.val("");
                    hiddenElement.val("");
                }
            });
        }
        // Event handler ketika radio button default diubah
        $(document).on("change", "input[name='DefaultUnitIndex']", function() {
            // 1. Set semua hidden input IsDefault menjadi false terlebih dahulu
            $("input[id^='hiddenIsDefault_']").val("false");
            // 2. Ambil index dari radio button yang sedang dipilih
            let selectedIndex = $(this).val();
            // 3. Ubah nilai hidden input pada baris yang dipilih menjadi true
            $("#hiddenIsDefault_" + selectedIndex).val("true");
        });
        // Perbaikan juga pada bagian remove agar index ID hidden input tetap sinkron saat dihapus
        $(document).on("click", ".remove", function(){
            $(this).closest("tr").remove();
            // Re-index ulang semua name dan id input setelah ada yang dihapus
            $("#tableUnits tbody tr").each(function(index) {
                // Update radio button value dan hidden input ID/name
                $(this).find("input[type='radio']").val(index);
                $(this).find("input").each(function() {
                    var name = $(this).attr("name");
                    var id = $(this).attr("id");
                    if (name) {
                        var newName = name.replace(/\[\d+\]/, "[" + index + "]");
                        $(this).attr("name", newName);
                    }
                    if (id && id.startsWith("hiddenIsDefault_")) {
                        $(this).attr("id", "hiddenIsDefault_" + index);
                    }
                });
            });
        });
    </script>
    <script>
        function previewImage(event) {
            var input = event.target;
            var reader = new FileReader();
            reader.onload = function () {
                document.getElementById("imgPreview").src = reader.result;
            };
            if (input.files && input.files[0]) {
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
    <script>
        // Cek apakah ada pesan SweetAlert dari Controller
        var sweetAlertMessage = '@TempData["SweetAlertMessage"]';
        var sweetAlertType = '@TempData["SweetAlertType"]';
        if (sweetAlertMessage && sweetAlertMessage.length > 0) {
            Swal.fire({
                title: sweetAlertType === 'warning' ? 'Peringatan Duplikasi!' : 'Berhasil!',
                text: sweetAlertMessage,
                icon: sweetAlertType,
                confirmButtonText: 'OK'
            });
        }
    </script>
    <script>
        // event listener untuk radio button
        $(document).on("change", "input[name='DefaultUnitIndex']", function() {
        // 1. Reset semua hidden field ke "false"
        $("input[id^='hiddenIsDefault_']").val("false");
        // 2. Ambil index yang dipilih
        let selectedIndex = $(this).val();
        // 3. Set hidden field yang bersangkutan menjadi "true"
        $("#hiddenIsDefault_" + selectedIndex).val("true");
        });
    </script>
    <script>
        $(document).ready(function () {
            // Event listener ketika isi dari textbox KodeBarcode berubah
            $('#KodeBarcode').on('change', function () {
                var barcodeValue = $(this).val().trim();
                // Jika input kosong, abaikan pencarian
                if (barcodeValue === "") {
                    return;
                }
                // Jalankan AJAX tanpa reload halaman
                $.ajax({
                    url: '@Url.Action("CekBarcode", "Produk")',
                    type: 'GET',
                    data: { barcode: barcodeValue },
                    success: function (response) {
                        if (response.exists) {
                            // Tampilkan SweetAlert jika barcode sudah terdaftar
                            Swal.fire({
                                icon: 'error',
                                title: 'Barcode Sudah Ada!',
                                text: 'Kode barcode "' + barcodeValue + '" sudah digunakan oleh produk lain. Silakan buat atau gunakan barcode lain.',
                                confirmButtonColor: '#3085d6',
                                position: 'top-end',
                                toast: true,
                                confirmButtonText: 'Oke'
                            }).then((result) => {
                                // Opsional: Kosongkan kembali input atau fokuskan ulang setelah user klik Oke
                                $('#KodeBarcode').val('').focus();
                            });
                        }
                    },
                      error: function (xhr, status, error) {
                        // Log ke console untuk kebutuhan debugging developer
                        console.error("Gagal melakukan validasi barcode:", error);
                        // Tampilkan pesan error ke user menggunakan SweetAlert2
                        Swal.fire({
                            icon: 'warning',
                            title: 'Koneksi Gagal',
                            text: 'Gagal memeriksa validasi barcode ke server. Silakan coba beberapa saat lagi.',
                            confirmButtonColor: '#d33',
                            position: 'top-end',
                            toast: true,
                            confirmButtonText: 'Tutup'
                        });
                    }
                });
            });
        });
    </script>
}
