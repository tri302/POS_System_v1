@model POS_System.Models.Shift
@{
    Layout = "~/Views/Shared/_KasirLayout.cshtml";
    ViewData["Title"] = "Manajemen Shift Kasir";
    var cultureIndo = new System.Globalization.CultureInfo("id-ID");
}
@if (ViewBag.IsExpiredShift == true)
{
    <div class="alert alert-danger">
        <strong>Perhatian!</strong> Shift ini milik tanggal @Model.WaktuBuka.ToString("dd MMM yyyy").
        Silakan lakukan perhitungan fisik uang sisa kemarin untuk menutup shift ini.
    </div>
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            @if (Model == null)
            {
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-primary text-white text-center py-4">
                        <h3 class="card-title mb-0 fw-bold">Mulai Shift Baru</h3>
                        <p class="mb-0 text-white-50 small">Silakan masukkan modal awal laci kasir Anda</p>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="OpenShift" id="openShiftForm" asp-controller="Shifts" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary">Modal Kas Awal (Rupiah)</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-light fw-bold text-muted">Rp</span>
                                    <input type="text" name="saldoAwal" class="form-control fw-bold text-primary format-rupiah" placeholder="0" required autofocus autocomplete="off" />
                                </div>
                                <div class="form-text text-muted mt-2">
                                    *Hitung uang fisik di laci dengan teliti sebelum memulai transaksi.
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
                                <i class="bi bi-play-fill me-1"></i> Buka Laci & Mulai Kerja
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-success text-white text-center py-4">
                        <div class="spinner-grow spinner-grow-sm text-light float-end" role="status"></div>
                        <h3 class="card-title mb-0 fw-bold">Shift Anda Sedang Aktif</h3>
                        <p class="mb-0 text-white-50 small">Laci kasir terkunci ke akun Anda</p>
                    </div>
                    <div class="card-body p-4">
                        <table class="table table-borderless my-2">
                            <tr>
                                <td class="text-muted text-start py-2">ID Shift</td>
                                <td class="fw-bold text-end py-2">#@Model.IdShift</td>
                            </tr>
                            <tr>
                                <td class="text-muted text-start py-2">Waktu Buka</td>
                                <td class="fw-bold text-end py-2">@Model.WaktuBuka.ToString("dd MMM 2026, HH:mm")</td>
                            </tr>
                            <tr>
                                <td class="text-muted text-start py-2">Modal Awal Laci</td>
                                <td class="fw-bold text-end py-2 text-info">@Model.SaldoAwal.ToString("C0", cultureIndo)</td>
                            </tr>
                        </table>
                        <hr class="my-4 text-muted">
                        <button type="button" class="btn btn-danger btn-lg w-100 shadow-sm" data-bs-toggle="modal" data-bs-target="#closeShiftModal">
                            <i class="bi bi-stop-fill me-1"></i> Selesai & Tutup Shift
                        </button>
                    </div>
                </div>
                <div class="modal fade" id="closeShiftModal" tabindex="-1" aria-labelledby="closeShiftModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow">
                            <div class="modal-header bg-danger text-white">
                                <h5 class="modal-title fw-bold" id="closeShiftModalLabel">Konfirmasi Tutup Shift</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form asp-action="CloseShift" asp-controller="Shifts" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idShift" value="@Model.IdShift" />
                                <div class="modal-body p-4">
                                    <div class="alert alert-warning small mb-3">
                                        <i class="bi bi-info-circle-fill me-1"></i> <strong>PENTING:</strong> Hitung total seluruh uang fisik yang ada di dalam laci kasir saat ini secara manual, lalu input nominalnya di bawah.
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-secondary">Total Uang Fisik di Laci</label>
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text bg-light fw-bold text-muted">Rp</span>
                                            <input type="text" name="saldoAkhirFisik" class="form-control fw-bold text-danger format-rupiah" placeholder="0" min="0" required autocomplete="off" />
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer bg-light border-0">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                                    <button type="submit" class="btn btn-danger px-4">Proses Rekonsiliasi & Tutup</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
@section Scripts {
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script>
            document.getElementById('openShiftForm').addEventListener('submit', function (e) {
            e.preventDefault();
            // 1. Ambil elemen input saldoAwal
            const inputSaldo = this.querySelector('input[name="saldoAwal"]');
            // 2. Simpan nilai asli yang ada titiknya (untuk dikembalikan nanti jika gagal)
            const nilaiAsli = inputSaldo.value;
            // 3. Bersihkan titik langsung pada input sebelum FormData dibuat
            inputSaldo.value = inputSaldo.value.replace(/\./g, '');
            // 4. Masukkan ke FormData (sekarang isinya sudah murni "500000")
            let formData = new FormData(this);
            // 5. Kembalikan tampilan input ke format ber-titik agar user tidak bingung
            inputSaldo.value = nilaiAsli;
            fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: {
                    "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Berhasil!',
                        text: data.message,
                        showConfirmButton: true,
                        timer: 3500,
                        position:'top'
                    }).then(() => {
                        window.location.href = data.redirectUrl;
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Gagal',
                        text: data.message
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Error', 'Terjadi kesalahan koneksi.', 'error');
            });
        });
    </script>
    <script>
        document.querySelectorAll('.format-rupiah').forEach(function (input) {
            // Event 1: Format otomatis saat user mengetik
            input.addEventListener('keyup', function (e) {
                this.value = formatRupiah(this.value);
            });
            // Event 2: Bersihkan titik sebelum form dikirim ke Controller (.NET)
            const form = input.closest('form');
            if (form) {
                form.addEventListener('submit', function () {
                    // Menghapus semua titik agar dibaca sebagai angka integer di Backend
                    input.value = input.value.replace(/\./g, '');
                });
            }
        });
        // Fungsi pembantu untuk memformat angka menjadi pemisah ribuan titik
        function formatRupiah(angka) {
            let number_string = angka.replace(/[^,\d]/g, '').toString(),
                split = number_string.split(','),
                sisa  = split[0].length % 3,
                rupiah = split[0].substr(0, sisa),
                ribuan = split[0].substr(sisa).match(/\d{3}/gi);
            if (ribuan) {
                let separator = sisa ? '.' : '';
                rupiah += separator + ribuan.join('.');
            }
            return split[1] != undefined ? rupiah + ',' + split[1] : rupiah;
        }
    </script>
}