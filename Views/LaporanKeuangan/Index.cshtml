@model POS_System.ViewModels.LaporanKeuanganIndexVm
@using System.Linq
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "List Laporan Keuangan";
}
<p align="right">
    <button type="button" id="btnCreate" class="btn btn-sm btn-success">
        <i class="fa fa-plus-square"></i>
        Create New
    </button>
</p>
<div id="LoadDataContainer">
    <table class="table table-responsive table-striped mt-2">
        <thead class="table-header-custom">
            <tr>
                <th>
                    Kode Laporan
                </th>
                <th>
                    Tipe Laporan
                </th>
                <th>
                    Dari Tanggal
                </th>
                <th>
                    Sampai Tanggal
                </th>
                <th class="text-center">#</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.LaporanKeuanganList != null && Model.LaporanKeuanganList.Any())
            {
                @foreach (var item in Model.LaporanKeuanganList)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.KodeLaporanKeuangan)
                        </td>
                        <td>
                            @if (item.TipeLaporan == "Masuk")
                            {
                                <span class="text-success">
                                    <i class="fas fa-check-circle"></i> @item.TipeLaporan
                                </span>
                            }
                            else if (item.TipeLaporan == "Keluar")
                            {
                                <span class="text-danger">
                                    <i class="fas fa-times-circle"></i> @item.TipeLaporan
                                </span>
                            }
                            else if (item.TipeLaporan == "Penjualan")
                            {
                                <span class="text-info">
                                    <i class="fas fa-info-circle"></i> @item.TipeLaporan
                                </span>
                            }
                            else
                            {
                                <span class="text-secondary">@item.TipeLaporan</span>
                            }
                        </td>
                        <td>
                            @(item.TanggalMulai.HasValue ? item.TanggalMulai.Value.ToString("dd/MM/yyyy") : "-")
                        </td>
                        <td>
                            @(item.TanggalSelesai.HasValue ? item.TanggalSelesai.Value.ToString("dd/MM/yyyy") : "-")
                        </td>
                        <td class="text-center">                            
                            <button class="btn btn-sm btn-success btn-download"
                                    data-tipelaporan="@item.TipeLaporan"
                                    data-tglmulai="@(item.TanggalMulai.HasValue ? item.TanggalMulai.Value.ToString("yyyy-MM-dd") : "")"
                                    data-tglselesai="@(item.TanggalSelesai.HasValue ? item.TanggalSelesai.Value.ToString("yyyy-MM-dd") : "")">
                                <i class="fa fa-download"></i> Download
                            </button>
                            <button class="btn btn-sm btn-primary btnEdit" data-id="@item.KodeLaporanKeuangan">
                                <i class="fa fa-edit"></i> Edit
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-bg-danger text-center">No records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@{
    // Definisikan jumlah tombol yang ingin ditampilkan di kedua sisi (misal: 4 di kiri, 5 di kanan, total 10 tombol)
    int maxButtons = 10;
    int pageNumber = Model.PageIndex; // Gunakan PageIndex yang benar
    int totalPages = Model.TotalPages;
    // Hitung halaman awal dan akhir yang akan ditampilkan
    int startPage;
    int endPage;
    if (totalPages <= maxButtons)
    {
        // Jika total halaman kurang dari batas, tampilkan semua
        startPage = 1;
        endPage = totalPages;
    }
    else
    {
        // Jika total halaman lebih dari batas
        int maxPagesToShow = maxButtons - 1; // 9 tombol lain + 1 tombol current = 10
        int sidePages = maxPagesToShow / 2; // Misalnya 4 atau 5
        if (pageNumber <= sidePages + 1)
        {
            // Jika di awal (tampilkan halaman 1 sampai batas)
            startPage = 1;
            endPage = maxButtons;
        }
        else if (pageNumber + sidePages >= totalPages)
        {
            // Jika di akhir (tampilkan batas terakhir)
            startPage = totalPages - maxPagesToShow;
            endPage = totalPages;
        }
        else
        {
            // Jika di tengah (tampilkan 4 ke kiri dan 5 ke kanan)
            startPage = pageNumber - sidePages;
            endPage = pageNumber + (maxPagesToShow - sidePages);
        }
    }
}
<div id="PagingContainer">
    @* --- Paging Navigation --- *@
    @if (Model != null && Model.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center">
            <ul class="pagination">
                @* Tombol Previous *@
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <button class="page-btn page-link" data-page="@(pageNumber - 1)">Previous</button>
                </li>
                @* Tombol Angka (Dibatasi) *@
                @for (var i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == pageNumber ? "active" : "")">
                        <button class="page-btn page-link" data-page="@i">@i</button>
                    </li>
                }
                @* Tombol Next *@
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <button class="page-btn page-link" data-page="@(pageNumber + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
</div>
<div id="ContainerModalCreate">
</div>
<div id="ContainerModalEdit">
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
           $(document).on('click', '.btn-download', function (e) {
            e.preventDefault();
            var btn = $(this);
            // Ubah pengiriman menjadi URLSearchParams (Form Data)
            var requestData = new URLSearchParams();
            requestData.append('tipelaporan', btn.data('tipelaporan'));
            requestData.append('tglMulai', btn.data('tglmulai'));
            requestData.append('tglSelesai', btn.data('tglselesai'));
            fetch('/LaporanKeuangan/DownloadLaporan', {
                method: 'POST',
                headers: {
                    // Ubah Content-Type menjadi form-urlencoded agar bisa dibaca langsung oleh parameter Controller
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: requestData.toString()
            })
            .then(response => {
                var contentType = response.headers.get("content-type");
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    return response.json().then(data => {
                        Swal.fire({
                            position: 'top-end',
                            toast: true,
                            icon: 'error',
                            title: 'Info',
                            text: data.message || 'Data tidak ditemukan.',
                            confirmButtonText: 'OK'
                        });
                    });
                } else {
                    return response.blob().then(blob => {
                        var url = window.URL.createObjectURL(blob);
                        var a = document.createElement('a');
                        a.href = url;
                        // Mengambil nama file dinamis dari header Content-Disposition jika ada,
                        // jika tidak ada kembali ke default "Laporan.pdf"
                        var contentDisposition = response.headers.get("Content-Disposition");
                        var fileName = "Laporan.pdf";
                        if (contentDisposition) {
                            // Regex untuk mencari filename="namafile.pdf" atau filename=namafile.pdf
                            var filenameRegex = /filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/;
                            var matches = filenameRegex.exec(contentDisposition);
                            if (matches != null && matches[1]) {
                                fileName = matches[1].replace(/['"]/g, '');
                            }
                        }
                        a.download = fileName;
                        document.body.appendChild(a);
                        a.click();
                        a.remove();
                        window.URL.revokeObjectURL(url);
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Error', 'Terjadi kesalahan sistem saat mengunduh data.', 'error');
            });
        });
    </script>
    <script>
            //Create
            $("#btnCreate").click(function() {
                $.get("/LaporanKeuangan/Create", function(html) {
                    $("#ContainerModalCreate").html(html);
                    $("#ModalCreate").modal('show');
                    $("#ContainerModalCreate").find(".datepicker").each(function() {
                        var displayId = $(this).attr('id');
                        var hiddenId = displayId.replace('_Display', '_Hidden');
                        $(this).datepicker({
                            dateFormat: "dd/mm/yy", // Tampilan yang diinginkan user
                            altField: "#" + hiddenId, // Target input untuk dikirim ke server
                            altFormat: "yy-mm-dd" // Format ISO yang dimengerti server
                        });
                    });
                    // Setelah Partial View dimuat, kita harus me-re-parse unobtrusive validation.
                    var form = $("#ModalCreate").find("form"); // Cari form di dalam modal
                    // Hapus data validasi yang lama (jika ada)
                    form.removeData("validator");
                    form.removeData("unobtrusiveValidation");
                    // Parse ulang validasi untuk form yang baru dimuat
                    $.validator.unobtrusive.parse(form);
                });
            });
        // Menggunakan event delegation untuk tombol Edit
        $(document).on("click", ".btnEdit", function() {
            var id = $(this).data("id");
            $.get("/LaporanKeuangan/Edit/" + id, function(html) {
                $("#ContainerModalEdit").html(html);
                $("#ModalEdit").modal('show');
                $("#ContainerModalEdit").find(".datepicker").each(function() {
                        var displayId = $(this).attr('id');
                        var hiddenId = displayId.replace('_Display', '_Hidden');
                        $(this).datepicker({
                            dateFormat: "dd/mm/yy", // Tampilan yang diinginkan user
                            altField: "#" + hiddenId, // Target input untuk dikirim ke server
                            altFormat: "yy-mm-dd" // Format ISO yang dimengerti server
                        });
                    });
                // Setelah Partial View dimuat, kita harus me-re-parse unobtrusive validation.
                var form = $("#ModalEdit").find("form"); // Cari form di dalam modal
                // Hapus data validasi yang lama (jika ada)
                form.removeData("validator");
                form.removeData("unobtrusiveValidation");
                // Parse ulang validasi untuk form yang baru dimuat
                $.validator.unobtrusive.parse(form);
            });
        });
        // Saat submit form modal (create/edit)
        $(document).on("submit", "form", function(e) {
            e.preventDefault();
            var form = $(this);
            // --- VALIDASI CLIENT-SIDE SEBELUM AJAX POST ---
            if (!form.valid()) {
                // Mendapatkan daftar error dari validator
                var validator = form.validate();
                var errors = validator.errorList;
                if (errors.length > 0) {
                    // 1. Tampilkan SweetAlert
                    Swal.fire({
                        icon: 'error',
                        title: 'Validasi Gagal!',
                        text: 'Harap isi semua kolom yang wajib diisi!!!.',
                        showConfirmButton: true,
                        timer: 4000,
                        position: 'top-end'
                    });
                    //2. Fokus ke elemen error pertama
                    var firstErrorElement = errors[0].element;
                    // Pastikan input visible sebelum diberi fokus
                    if ($(firstErrorElement).is(':visible')) {
                        $(firstErrorElement).focus();
                        $(firstErrorElement).addClass('is-invalid'); // Tambahkan kelas error
                    }
                    // Hentikan proses AJAX
                    return;
                }
            }
            //var formData = new FormData(form[0]); // Gunakan FormData untuk mengirim file
            $.ajax({
                url: form.attr("action"),
                method: form.attr("method"),
                data: form.serialize(), //ganti dengan formData untuk support upload file
                success: function(res) {
                    if (res.success) {
                        // Logika Swal.fire untuk sukses
                        Swal.fire({
                            icon: 'success',
                            title: 'Berhasil',
                            text: res.message,
                            showConfirmButton: true,
                            timer: 5000,
                            position: 'top-end',
                            toast: true
                        }).then(() => {
                            window.location.href = "/LaporanKeuangan/Index";
                        });
                        $("#ModalCreate").modal('hide'); // Sembunyikan modal
                    } else {
                        // Jika ada error validasi dari server (res bukan JSON sukses, tapi HTML Partial View)
                        // Pastikan Controller mengembalikan PartialView(metodeBayar) jika ModelState tidak valid.
                        form.parent().html(res);
                        // Re-parse lagi validasi untuk form yang baru di-update
                        var newForm = form.parent().find("form");
                        newForm.removeData("validator");
                        newForm.removeData("unobtrusiveValidation");
                        $.validator.unobtrusive.parse(newForm);
                    }
                },
                error: function(xhr, status, error) {
                    // Penanganan error AJAX umum jika diperlukan
                    console.error("AJAX Error: " + status + error);
                    //alert("Terjadi kesalahan saat menyimpan data.");
                    Swal.fire({
                        icon: 'info',
                        title: 'Gagal',
                        text: xhr.responseText,
                        showConfirmButton: true,
                        timer: 5000,
                        position: 'top-end',
                        toast: true
                    })
                }
            });
        });
    </script>
    <script>
            $(document).ready(function() {
                attachPagingListeners();
            });
        // Fungsi utama untuk memuat halaman via AJAX
        function loadPage(pageNumber) {
            // Tampilkan loading spinner (opsional)
            $('#LoadDataContainer').html('<div class="text-center"><i class="fa fa-spinner fa-spin fa-3x"></i> Loading...</div>');
            $('.pagination').hide();
            $.ajax({
                url: '@Url.Action("LoadPage", "LaporanKeuangan")',
                type: 'GET',
                data: {
                    pageNumber: pageNumber
                }, // Kirim nomor halaman
                success: function(html) {
                        var newTableContent = $(html).find('#LoadDataContainer').html();
                        $('#LoadDataContainer').html(newTableContent);
                        var newPagingContent = $(html).find('#PagingContainer').html();
                        $('#PagingContainer').html(newPagingContent).show();
                        attachPagingListeners();
                        // Opsional: Tampilkan kembali pagination jika disembunyikan
                        $('.pagination').show();
                },
                error: function(xhr, status, error) {
                    // Tampilkan pesan error jika gagal
                    alert("Error loading page: " + xhr.responseText);
                    // Hapus spinner/tampilkan pesan error di container
                    $('#LoadDataContainer').html('<div class="alert alert-danger text-center">Gagal memuat data. Silakan coba lagi.</div>');
                }
            });
        }
        // Fungsi untuk melampirkan/melampirkan ulang event listener ke tombol pagination
        function attachPagingListeners() {
            // Hapus listener sebelumnya sebelum melampirkan yang baru
            $(document).off("click", ".page-btn").on("click", ".page-btn", function(e) {
                e.preventDefault();
                var targetPage = parseInt($(this).data("page"));
                // Cek apakah tombol disable
                if ($(this).parent().hasClass("disabled")) {
                    return; // Jangan lakukan apa-apa jika disabled
                }
                loadPage(targetPage);
            });
        }
    </script>
}