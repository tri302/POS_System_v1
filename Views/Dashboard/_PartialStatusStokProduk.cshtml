@using POS_System.ViewModels
@model DashboardIndexVm
<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">
        <i class="fas fa-solid fa-exclamation-triangle me-2"></i>
        Status Stok Produk
    </div>
    <div class="card-body p-0">
        <div class="p-3">
            <input type="text" class="form-control" id="CariStatusStokProduk" value="@ViewBag.SearchStatusStok" placeholder="Cari">
        </div>
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:70px">Gambar</th>
                    <th>Nama Produk</th>
                    <th>Units</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.StatusStokProduk)
                {
                    <tr>
                        <td>
                            @if (string.IsNullOrEmpty(item.GambarUrl))
                            {
                                <img src="/images/no-image.png" class="rounded" width="40" />
                            }
                            else
                            {
                                <img src="@item.GambarUrl"
                                     class="rounded"
                                     width="40"
                                     onerror="this.onerror=null; this.src='/images/no-image.png';" />
                            }
                        </td>
                        <td>@item.NamaProduk</td>
                        <td>
                            @item.Stok @item.UnitName
                        </td>
                        <td>
                            @if (item.Status == "Hampir Habis")
                            {
                                <span class="badge bg-warning text-dark">Hampir Habis</span>
                            }
                            else if (item.Status == "Habis")
                            {
                                <span class="badge bg-danger">Habis</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Aman</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
