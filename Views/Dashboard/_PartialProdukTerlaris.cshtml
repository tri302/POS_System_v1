@using POS_System.ViewModels
@model DashboardIndexVm
<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">
        <i class="fas fa-solid fa-chart-line me-2"></i>
        Produk Terlaris
    </div>
    <div class="card-body p-0">
        <div class="p-3">
            <input type="text" class="form-control" id="CariProdukLaris" value="@ViewBag.SearchLaris" placeholder="Cari">
        </div>
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:70px">Gambar</th>
                    <th>Nama Produk</th>
                    <th class="text-end">Jumlah Pembelian</th>                    
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ProdukTerlaris)
                {
                    <tr>
                        <td>
                            @if (string.IsNullOrEmpty(item.GambarUrl))
                            {
                                <img src="/images/no-image.png" class="rounded" width="40" />
                            }
                            else
                            {
                                <img src="@item.GambarUrl"
                                     class="rounded"
                                     width="40"
                                     onerror="this.onerror=null; this.src='/images/no-image.png';" />
                            }
                        </td>
                        <td>@item.NamaProduk</td>
                        <td class="text-end fw-semibold">
                            @item.TotalTerjual @item.UnitName
                        </td>                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
